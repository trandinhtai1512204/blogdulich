generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id              // Supabase auth.uid() (UUID)
  email     String    @unique
  name      String?
  avatar    String?
  role      Role      @default(user)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  reviews   Review[]
  posts     Post[]

  @@map("users")
}

model City {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  country     String
  image       String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[]
  hotels      Hotel[]
  posts       Post[]

  @@map("cities")
}

model Hotel {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  address        String
  price          Float
  images         String[]
  description    String?
  availableRooms Int       @default(0)
  cityId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
  city           City      @relation(fields: [cityId], references: [id])
  reviews        Review[]

  @@index([cityId])
  @@index([price])
  @@map("hotels")
}

model Category {
  id        String        @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime      @default(now())
  cityId    String?
  parentId  String?
  type      CategoryType  @default(destination)
  level     CategoryLevel
  city      City?         @relation(fields: [cityId], references: [id])
  parent    Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[]    @relation("CategoryParent")
  posts     Post[]

  @@unique([parentId, slug])
  @@index([type])
  @@index([level])
  @@index([cityId])
  @@index([parentId])
  @@map("categories")
}

model Post {
  id         String    @id @default(cuid())
  title      String
  slug       String
  supportingUrlSlug String? @unique
  content    String
  excerpt    String?
  thumbnail  String?
  location   String?
  latitude   Float?
  longitude  Float?
  viewCount  Int        @default(0)
  kind       PostKind   @default(standard)
  published  Boolean   @default(false)
  status     PostStatus @default(pending)
  authorId   String?
  cityId     String?
  categoryId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User?     @relation(fields: [authorId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])
  city       City?     @relation(fields: [cityId], references: [id])
  supportLinksFrom SupportingArticleLink[] @relation("MainPostSupportLinks")
  supportLinksTo   SupportingArticleLink[] @relation("SupportPostLinks")

  @@index([authorId])
  @@unique([categoryId, slug])
  @@index([kind])
  @@index([supportingUrlSlug])
  @@index([cityId])
  @@index([categoryId])
  @@index([status, createdAt(sort: Desc)])
  @@index([published, createdAt(sort: Desc)])
  @@index([published, viewCount(sort: Desc), createdAt(sort: Desc)])
  @@index([categoryId, published, createdAt(sort: Desc)])
  @@index([cityId, published, viewCount(sort: Desc), createdAt(sort: Desc)])
  @@map("posts")
}

model SupportingArticleLink {
  id                String   @id @default(cuid())
  mainPostId        String
  supportPostId     String
  anchorText        String?
  secondaryKeywords String?
  sortOrder         Int      @default(0)
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  mainPost          Post     @relation("MainPostSupportLinks", fields: [mainPostId], references: [id], onDelete: Cascade)
  supportPost       Post     @relation("SupportPostLinks", fields: [supportPostId], references: [id], onDelete: Cascade)

  @@unique([mainPostId, supportPostId])
  @@index([mainPostId, sortOrder])
  @@index([supportPostId, isPrimary])
  @@map("supporting_article_links")
}

model Faq {
  id         String        @id @default(cuid())
  targetType FaqTargetType
  targetId   String?
  module     CategoryType?
  question   String
  answer     String
  sortOrder  Int           @default(0)
  published  Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([targetType, targetId])
  @@index([module])
  @@index([published])
  @@map("faqs")
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  hotelId    String
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float
  status     BookingStatus @default(pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  expiresAt  DateTime?
  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  payment    Payment?

  @@index([userId])
  @@index([hotelId])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  provider      String        @default("stripe")
  transactionId String?
  amount        Float
  status        PaymentStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  currency      String        @default("usd")
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  hotelId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@index([userId])
  @@map("reviews")
}

enum Role {
  admin
  user
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  failed
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum CategoryType {
  destination
  itinerary
  review
  experience
}

enum FaqTargetType {
  global
  category
  city
  post
}

enum CategoryLevel {
  ROOT
  SUBTYPE
  CITY
  SUB
}

enum PostStatus {
  pending
  approved
  rejected
}

enum PostKind {
  standard
  supporting
}
